{
  "client": {
    "allowed_origins": ["http://localhost:3001", "http://127.0.0.1:3001"],
    "token": {
      "hmac_secret_key": "dev-hmac-secret"
    }
  },
  "http_api": {
    "key": "dev-api-key"
  },
  "admin": {
