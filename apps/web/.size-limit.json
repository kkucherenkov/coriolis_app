[
  {
    "name": "Total JS (all client chunks, brotli)",
    "path": ".output/public/_nuxt/*.js",
    "limit": "435 kB"
  },
  {
    "name": "Total CSS (all client styles, brotli)",
    "path": ".output/public/_nuxt/*.css",
    "limit": "65 kB"
  },
  {
    "name": "Entry CSS (initial paint, brotli)",
    "path": ".output/public/_nuxt/entry.*.css",
    "limit": "25 kB"
  },
  {
    "name": "Largest dynamic-route CSS (/*/[id] pages, brotli)",
    "path": ".output/public/_nuxt/_id_.*.css",
    "limit": "10 kB"
  }
]
