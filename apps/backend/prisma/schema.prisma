// Prisma schema — Better Auth tables are generated by
// `pnpm --filter @app/backend auth:generate-schema` and merged here.
// Add domain models below the auth section.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----- Better Auth -----

model User {
  id                  String        @id
  name                String
  email               String        @unique
  emailVerified       Boolean
  image               String?
  createdAt           DateTime
  updatedAt           DateTime
  phoneNumber         String?       @unique
  phoneNumberVerified Boolean?
  displayName         String?
  theme               String?       @default("dark")
  deletedAt           DateTime?
  sessions            Session[]
  accounts            Account[]
  characters          Character[]
  gameSessions        GameSession[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ----- Domain -----

/// Lifecycle state of a Character row.
/// DRAFT   — wizard-in-progress; excluded from the default list query.
/// ACTIVE  — published character; visible on the dashboard.
enum CharacterStatus {
  ACTIVE
  DRAFT

  @@map("character_status")
}

/// Social stratum a character was raised in. Set at creation, immutable.
/// Drives starting attribute / skill point budgets, reputation, and wealth
/// (Coriolis core book ch.2, table 2.2). Wire values are lowercase.
enum Upbringing {
  plebeian
  stationary
  aristocrat

  @@map("upbringing")
}

/// One of the 11 character archetypes (амплуа) per Coriolis core book ch.2.
/// Determines the key attribute (cap 5 at creation), key skills (cap 3),
/// and reputation modifier. Mapped to lowercase wire values.
enum Concept {
  artist
  networker
  fugitive
  negotiator
  operative
  pilot
  pioneer
  preacher
  scientist
  sailor
  soldier

  @@map("concept")
}

/// One of the nine Coriolis Icons (enum mirrors the OpenAPI IconId type).
enum IconId {
  lady_of_tears  @map("lady-of-tears")
  traveler
  messenger
  merchant
  dancer
  gambler
  judge
  faceless_one   @map("faceless-one")
  deckhand

  @@map("icon_id")
}

/// A player character in the Coriolis campaign.
///
/// Design notes:
/// - `attributes` and `skills` are stored as JSON columns (Prisma Json type)
///   rather than separate Attributes/Skills tables. Rationale: both objects
///   have a fixed, closed schema (8 attrs, 16 skills); they are always read and
///   written as a unit; there is no foreign-key join benefit. A Json column
///   gives us schema flexibility for future optional fields without a migration.
/// - `conditions` is a JSON column holding the four boolean flags (exhausted,
///   sleepless, thirsty, hungry) — same rationale as above.
/// - `hpMax`, `mpMax`, `encumbranceMax` are NOT stored — they are derived by
///   the RulesEngine from the stored attributes (Story 3.2.2). Storing them
///   would create a synchronisation risk with no benefit.
/// - `encumbranceCurrent` is also NOT stored — it is computed from item weights
///   by the read mapper (sum of item.data.weight where applicable).
/// - Character delete is a HARD delete; Prisma cascades to all children.
model Character {
  id                  String           @id @default(cuid())
  ownerId             String
  owner               User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                String
  /// One of 11 archetypes (амплуа). Nullable so the wizard can save a
  /// draft before the user picks; required (validated) on `active`.
  concept             Concept?
  iconId              IconId?
  /// Social stratum at birth — drives the creation-time attribute / skill
  /// budgets, starting reputation, and starting wealth (ch.2 table 2.2).
  /// Defaults to plebeian for legacy rows that pre-date this column; the
  /// CreateCharacterHandler always supplies an explicit value.
  upbringing          Upbringing       @default(plebeian)
  /// Free-text narrative description of where the character is from
  /// (home station, planet, region). No mechanical effect.
  origin              String?
  /// Current reputation. Initial value derived from upbringing
  /// (plebeian=2, stationary=4, aristocrat=6) and may change in play.
  reputation          Int              @default(2)
  /// Birrs the character started with. Derived from upbringing and frozen
  /// at creation (plebeian=500, stationary=1000, aristocrat=5000).
  startingWealth      Int              @default(500)
  /// JSON column: { strength, agility, wits, empathy } — each 1–5.
  attributes          Json
  /// JSON column: { dexterity, force, infiltration, manipulation, meleeCombat,
  ///   observation, rangedCombat, survival, command, culture, dataDjinn,
  ///   medicurgy, mysticPowers, pilot, science, technology } — each 0–5.
  skills              Json
  hpCurrent           Int              @default(14)
  mpCurrent           Int              @default(10)
  experience          Int              @default(0)
  /// JSON column: { exhausted, sleepless, thirsty, hungry } — all booleans.
  conditions          Json
  notes               String?
  /// Lifecycle state: ACTIVE (default, dashboard-visible) or DRAFT (wizard-in-progress).
  /// Draft characters are excluded from the list endpoint unless ?includeDrafts=true.
  /// Cleanup of abandoned drafts runs nightly (CleanupAbandonedDraftsJob — 30-day window).
  status              CharacterStatus  @default(ACTIVE)
  items               Item[]
  talents             Talent[]
  relationships       Relationship[]
  criticalInjuries    CriticalInjury[]
  shareLinks          ShareLink[]
  rolls               Roll[]
  gameSessions        CharacterGameSession[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([ownerId])
  @@index([status])
  @@map("character")
}

/// Discriminator values for the Item type column.
/// Mirrors the OpenAPI discriminator and the ItemType used in generated types.
enum ItemType {
  WEAPON
  ARMOR
  GEAR
  CYBERNETIC
  SHIP_MODULE
  OTHER

  @@map("item_type")
}

/// An inventory item belonging to a character.
///
/// Design notes (reasoning):
/// - A single `data Json` column holds the type-specific payload rather than
///   one table per item type. Rationale: Coriolis v1 has six item types with
///   overlapping but not identical fields; a discriminated-union JSON column
///   avoids 6 nullable tables and matches the OpenAPI `oneOf` discriminator
///   exactly. The `type` column serves as the discriminator. Type-specific
///   validation is done at the application layer (command handler) because
///   Postgres does not enforce JSON structure.
/// - Cascade-delete is ON: deleting a character removes all its items.
model Item {
  id          String      @id @default(cuid())
  characterId String
  character   Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  type        ItemType
  /// Type-specific payload. Structure depends on `type`:
  ///   WEAPON:      { name, damage, range, bonus, crit, weight, features, equipped }
  ///   ARMOR:       { name, armorRating, weight, features, equipped }
  ///   GEAR:        { name, weight, quantity, notes? }
  ///   CYBERNETIC:  { name, bodyPoints, effect }
  ///   SHIP_MODULE: { name, slot, effect }
  ///   OTHER:       { name, weight, notes? }
  data        Json

  @@index([characterId])
  @@map("item")
}

/// A talent (special ability) owned by a character.
model Talent {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name        String
  description String
  rank        Int       @default(1)
  acquiredAt  DateTime  @default(now())

  @@index([characterId])
  @@map("talent")
}

enum RelationshipKind {
  ally
  rival
  family
  mentor
  debtor
  creditor

  @@map("relationship_kind")
}

/// A named relationship between a character and an NPC or other PC.
model Relationship {
  id          String           @id @default(cuid())
  characterId String
  character   Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  targetName  String
  kind        RelationshipKind
  notes       String?

  @@index([characterId])
  @@map("relationship")
}

enum InjurySeverity {
  LIGHT
  SEVERE
  CRITICAL

  @@map("injury_severity")
}

/// A public read-only share link for a character.
///
/// Design notes (ADR 0003):
/// - `slug` is a 24-character nanoid from an unambiguous alphabet — effectively
///   unguessable and safe to print.
/// - Revocation is soft: `revokedAt` is set; the row is never deleted so that
///   historical view counts are preserved.
/// - `viewCount` and `lastViewedAt` are updated asynchronously by the
///   FlushViewTrackerJob every minute. The read path does not write to the DB.
/// - `onDelete: Cascade` ensures share links are removed when the character is
///   hard-deleted.
model ShareLink {
  id             String    @id @default(cuid())
  slug           String    @unique
  characterId    String
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  includeGmNotes Boolean   @default(false)
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastViewedAt   DateTime?
  viewCount      Int       @default(0)
  label          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([characterId])
  @@index([revokedAt])
  @@map("share_link")
}

/// Lifecycle state of a GameSession row.
/// ACTIVE   — session in progress or available.
/// ARCHIVED — session closed; excluded from the default list query.
enum GameSessionStatus {
  ACTIVE
  ARCHIVED

  @@map("game_session_status")
}

/// Source of a DpEvent row.
enum DpSource {
  GM_MANUAL
  ROLL_PUSH
  SYSTEM

  @@map("dp_source")
}

/// A campaign session container owned by a GM.
///
/// Design notes:
/// - `dpCount` is always mutated atomically by UpdateDpCommand (Feature 7.3).
///   Never written directly from the PATCH endpoint.
/// - Characters are linked via the `CharacterGameSession` join table so the
///   many-to-many relation stays clean. The array of characterIds is assembled
///   at read time by the repo.
/// - `shipId` is a loose foreign-key string; the Ship model is added in Epic 8.
///   It is not declared as a Prisma relation here to avoid a circular dep on a
///   model that doesn't exist yet.
model GameSession {
  id          String                @id @default(cuid())
  ownerId     String
  owner       User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      GameSessionStatus     @default(ACTIVE)
  dpCount     Int                   @default(0)
  shipId      String?
  characters  CharacterGameSession[]
  dpEvents    DpEvent[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([ownerId, status])
  @@map("game_session")
}

/// An audit event for a Darkness Points adjustment on a GameSession.
///
/// Design notes:
/// - Inserted in the same transaction as the dpCount update (UpdateDpCommand).
/// - `rollId` is a nullable loose FK — set when source = ROLL_PUSH.
/// - `@@index([gameSessionId, createdAt])` supports the paginated list query.
model DpEvent {
  id            String      @id @default(cuid())
  gameSessionId String
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  delta         Int
  reason        String?
  source        DpSource
  rollId        String?
  createdAt     DateTime    @default(now())

  @@index([gameSessionId, createdAt])
  @@map("dp_event")
}

/// Join table linking characters to game sessions.
///
/// The composite primary key prevents duplicate assignments.
/// Cascade-deletes ensure the join row is removed when either side is deleted.
model CharacterGameSession {
  characterId   String
  gameSessionId String
  character     Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  assignedAt    DateTime    @default(now())

  @@id([characterId, gameSessionId])
  @@index([gameSessionId])
  @@map("character_game_session")
}

/// A critical injury recorded on a character's sheet.
model CriticalInjury {
  id          String         @id @default(cuid())
  characterId String
  character   Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name        String
  severity    InjurySeverity
  effect      String
  acquiredAt  DateTime       @default(now())

  @@index([characterId])
  @@map("critical_injury")
}

/// A Coriolis dice roll result, persisted for roll history and the push mechanic.
///
/// Design notes:
/// - `dice` is a Postgres integer array — all pool dice are stored together; after
///   a push the non-6 values are updated in place so the array always has `pool`
///   elements.
/// - `hits` is a derived value but is stored to avoid recounting on every read.
///   It is recomputed and overwritten on push.
/// - `gameSessionId` is a nullable String (no FK constraint yet) — the GameSession
///   resource lands in Feature 7.2. The FK will be added in the Feature 7.2
///   migration once the GameSession table exists.
/// - Cascade delete ensures rolls disappear when their character is hard-deleted.
model Roll {
  id            String    @id @default(cuid())
  characterId   String
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// Nullable until Feature 7.2 ships the GameSession resource.
  gameSessionId String?
  label         String
  pool          Int
  dice          Int[]
  hits          Int
  pushed        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([characterId, createdAt])
  @@index([gameSessionId])
  @@map("roll")
}
