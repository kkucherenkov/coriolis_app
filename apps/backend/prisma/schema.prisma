// Prisma schema — Better Auth tables are generated by
// `pnpm --filter @app/backend auth:generate-schema` and merged here.
// Add domain models below the auth section.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----- Better Auth -----

model User {
  id                  String        @id
  name                String
  email               String        @unique
  emailVerified       Boolean
  image               String?
  createdAt           DateTime
  updatedAt           DateTime
  phoneNumber         String?       @unique
  phoneNumberVerified Boolean?
  displayName         String?
  theme               String?       @default("dark")
  deletedAt           DateTime?
  sessions            Session[]
  accounts            Account[]
  characters          Character[]
  gameSessions        GameSession[]
  ships               Ship[]
  npcs                Npc[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ----- Domain -----

/// Lifecycle state of a Character row.
/// DRAFT   — wizard-in-progress; excluded from the default list query.
/// ACTIVE  — published character; visible on the dashboard.
enum CharacterStatus {
  ACTIVE
  DRAFT

  @@map("character_status")
}

/// Social stratum a character was raised in. Set at creation, immutable.
/// Drives starting attribute / skill point budgets, reputation, and wealth
/// (Coriolis core book ch.2, table 2.2). Wire values are lowercase.
enum Upbringing {
  plebeian
  stationary
  aristocrat

  @@map("upbringing")
}

/// One of the 11 character archetypes (амплуа) per Coriolis core book ch.2.
/// Determines the key attribute (cap 5 at creation), key skills (cap 3),
/// and reputation modifier. Mapped to lowercase wire values.
enum Concept {
  artist
  networker
  fugitive
  negotiator
  operative
  pilot
  pioneer
  preacher
  scientist
  sailor
  soldier

  @@map("concept")
}

/// Crew (амплуа команды) per Coriolis core book ch.2 §АМПЛУА КОМАНДЫ.
/// Five canonical crews — the team picks one, all members share it.
/// Mapped to kebab-case wire values via @map.
enum CrewConcept {
  free_trader @map("free-trader")
  mercenary
  explorer
  agents
  pilgrim

  @@map("crew_concept")
}

/// Mutant lineage (родословная пасынков) per Coriolis ST3001 ch.4 §Стигмы пасынков.
/// Three canonical lineages — Зирба / Шингура / Нерида. Set together with
/// `Character.mutant=true`; null otherwise.
enum MutantLineage {
  zirba
  shingura
  nerida

  @@map("mutant_lineage")
}

/// Discriminator for Talent.kind. At creation each character has one
/// of each non-`personal` kind plus one personal; further talents
/// acquired during play are always `personal`.
enum TalentKind {
  personal
  crew
  iconGift
  stigma

  @@map("talent_kind")
}

/// One of the nine Coriolis Icons (enum mirrors the OpenAPI IconId type).
enum IconId {
  lady_of_tears  @map("lady-of-tears")
  traveler
  messenger
  merchant
  dancer
  gambler
  judge
  faceless_one   @map("faceless-one")
  deckhand

  @@map("icon_id")
}

/// A player character in the Coriolis campaign.
///
/// Design notes:
/// - `attributes` and `skills` are stored as JSON columns (Prisma Json type)
///   rather than separate Attributes/Skills tables. Rationale: both objects
///   have a fixed, closed schema (8 attrs, 16 skills); they are always read and
///   written as a unit; there is no foreign-key join benefit. A Json column
///   gives us schema flexibility for future optional fields without a migration.
/// - `conditions` is a JSON column holding the four boolean flags (exhausted,
///   sleepless, thirsty, hungry) — same rationale as above.
/// - `hpMax`, `mpMax`, `encumbranceMax` are NOT stored — they are derived by
///   the RulesEngine from the stored attributes (Story 3.2.2). Storing them
///   would create a synchronisation risk with no benefit.
/// - `encumbranceCurrent` is also NOT stored — it is computed from item weights
///   by the read mapper (sum of item.data.weight where applicable).
/// - Character delete is a HARD delete; Prisma cascades to all children.
model Character {
  id                  String           @id @default(cuid())
  ownerId             String
  owner               User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                String
  /// One of 11 archetypes (амплуа). Nullable so the wizard can save a
  /// draft before the user picks; required (validated) on `active`.
  concept             Concept?
  /// Canonical role within the chosen amplua (ГЛАВА 2 «АМПЛУА И РОЛИ»).
  /// 33-value enum stored as a string for now (we can promote to a Postgres
  /// enum later — keeping it loose during the migration window). Nullable
  /// for drafts and for legacy rows created before role-tracking landed.
  role                String?
  /// Marks rows whose `role` was filled in by the canon-alignment backfill
  /// migration rather than by an explicit user pick. The wizard re-prompts
  /// for a role on the next edit when this is true; once the user confirms,
  /// the handler clears the flag.
  roleUnmigrated      Boolean         @default(false)
  iconId              IconId?
  /// Social stratum at birth — drives the creation-time attribute / skill
  /// budgets, starting reputation, and starting wealth (ch.2 table 2.2).
  /// Defaults to plebeian for legacy rows that pre-date this column; the
  /// CreateCharacterHandler always supplies an explicit value.
  upbringing          Upbringing       @default(plebeian)
  /// Free-text narrative description of where the character is from
  /// (home station, planet, region). No mechanical effect.
  origin              String?
  /// Current reputation. Initial value derived from upbringing
  /// (plebeian=2, stationary=4, aristocrat=6) and may change in play.
  reputation          Int              @default(2)
  /// Birrs the character started with. Derived from upbringing and frozen
  /// at creation (plebeian=500, stationary=1000, aristocrat=5000).
  startingWealth      Int              @default(500)
  /// Optional crew amplua (амплуа команды). Mutable while draft, frozen
  /// once active. Drives the crew-talent picker on the wizard.
  crewConcept         CrewConcept?
  /// Mutant flag (пасынок). When true, character carries a stigma talent
  /// from the catalog matching `mutantLineage`. Mutable while draft,
  /// frozen once active.
  mutant              Boolean          @default(false)
  /// Mutant lineage. Null for non-mutants; set together with `mutant=true`.
  mutantLineage       MutantLineage?
  /// JSON column: { strength, agility, wits, empathy } — each 1–5.
  attributes          Json
  /// JSON column: { dexterity, force, infiltration, manipulation, meleeCombat,
  ///   observation, rangedCombat, survival, command, culture, dataDjinn,
  ///   medicurgy, mysticPowers, pilot, science, technology } — each 0–5.
  skills              Json
  hpCurrent           Int              @default(14)
  mpCurrent           Int              @default(10)
  experience          Int              @default(0)
  /// JSON column: { exhausted, sleepless, thirsty, hungry } — all booleans.
  conditions          Json
  notes               String?
  /// Lifecycle state: ACTIVE (default, dashboard-visible) or DRAFT (wizard-in-progress).
  /// Draft characters are excluded from the list endpoint unless ?includeDrafts=true.
  /// Cleanup of abandoned drafts runs nightly (CleanupAbandonedDraftsJob — 30-day window).
  status              CharacterStatus  @default(ACTIVE)
  items               Item[]
  talents             Talent[]
  relationships       Relationship[]
  criticalInjuries    CriticalInjury[]
  shareLinks          ShareLink[]
  rolls               Roll[]
  gameSessions        CharacterGameSession[]
  crewAssignments     CrewSlot[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([ownerId])
  @@index([status])
  @@map("character")
}

/// Discriminator values for the Item type column.
/// Mirrors the OpenAPI discriminator and the ItemType used in generated types.
enum ItemType {
  WEAPON
  ARMOR
  GEAR
  CYBERNETIC
  SHIP_MODULE
  OTHER

  @@map("item_type")
}

/// An inventory item belonging to a character.
///
/// Design notes (reasoning):
/// - A single `data Json` column holds the type-specific payload rather than
///   one table per item type. Rationale: Coriolis v1 has six item types with
///   overlapping but not identical fields; a discriminated-union JSON column
///   avoids 6 nullable tables and matches the OpenAPI `oneOf` discriminator
///   exactly. The `type` column serves as the discriminator. Type-specific
///   validation is done at the application layer (command handler) because
///   Postgres does not enforce JSON structure.
/// - Cascade-delete is ON: deleting a character removes all its items.
model Item {
  id          String      @id @default(cuid())
  characterId String
  character   Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  type        ItemType
  /// Type-specific payload. Structure depends on `type`:
  ///   WEAPON:      { name, damage, range, bonus, crit, weight, features, equipped }
  ///   ARMOR:       { name, armorRating, weight, features, equipped }
  ///   GEAR:        { name, weight, quantity, notes? }
  ///   CYBERNETIC:  { name, bodyPoints, effect }
  ///   SHIP_MODULE: { name, slot, effect }
  ///   OTHER:       { name, weight, notes? }
  data        Json

  @@index([characterId])
  @@map("item")
}

/// A talent (special ability) owned by a character.
model Talent {
  id          String     @id @default(cuid())
  characterId String
  character   Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// Discriminator (personal | crew | iconGift | stigma). Defaults to
  /// `personal` for legacy rows and the common case (talents acquired
  /// during play are always personal). Each character can have at most
  /// one of each non-`personal` kind — enforced at the application layer.
  kind        TalentKind @default(personal)
  name        String
  description String
  rank        Int        @default(1)
  acquiredAt  DateTime   @default(now())

  @@index([characterId])
  @@map("talent")
}

enum RelationshipKind {
  ally
  rival
  family
  mentor
  debtor
  creditor

  @@map("relationship_kind")
}

/// A named relationship between a character and an NPC or other PC.
model Relationship {
  id          String           @id @default(cuid())
  characterId String
  character   Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  targetName  String
  kind        RelationshipKind
  notes       String?

  @@index([characterId])
  @@map("relationship")
}

enum InjurySeverity {
  LIGHT
  SEVERE
  CRITICAL

  @@map("injury_severity")
}

/// A public read-only share link for a character.
///
/// Design notes (ADR 0003):
/// - `slug` is a 24-character nanoid from an unambiguous alphabet — effectively
///   unguessable and safe to print.
/// - Revocation is soft: `revokedAt` is set; the row is never deleted so that
///   historical view counts are preserved.
/// - `viewCount` and `lastViewedAt` are updated asynchronously by the
///   FlushViewTrackerJob every minute. The read path does not write to the DB.
/// - `onDelete: Cascade` ensures share links are removed when the character is
///   hard-deleted.
model ShareLink {
  id             String    @id @default(cuid())
  slug           String    @unique
  characterId    String
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  includeGmNotes Boolean   @default(false)
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastViewedAt   DateTime?
  viewCount      Int       @default(0)
  label          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([characterId])
  @@index([revokedAt])
  @@map("share_link")
}

/// Lifecycle state of a GameSession row.
/// ACTIVE   — session in progress or available.
/// ARCHIVED — session closed; excluded from the default list query.
enum GameSessionStatus {
  ACTIVE
  ARCHIVED

  @@map("game_session_status")
}

/// Source of a DpEvent row.
enum DpSource {
  GM_MANUAL
  ROLL_PUSH
  SYSTEM

  @@map("dp_source")
}

/// A campaign session container owned by a GM.
///
/// Design notes:
/// - `dpCount` is always mutated atomically by UpdateDpCommand (Feature 7.3).
///   Never written directly from the PATCH endpoint.
/// - Characters are linked via the `CharacterGameSession` join table so the
///   many-to-many relation stays clean. The array of characterIds is assembled
///   at read time by the repo.
/// - `shipId` is a loose foreign-key string; the Ship model is added in Epic 8.
///   It is not declared as a Prisma relation here to avoid a circular dep on a
///   model that doesn't exist yet.
model GameSession {
  id          String                @id @default(cuid())
  ownerId     String
  owner       User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      GameSessionStatus     @default(ACTIVE)
  dpCount     Int                   @default(0)
  shipId      String?
  characters  CharacterGameSession[]
  dpEvents    DpEvent[]
  encounters  Encounter[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([ownerId, status])
  @@map("game_session")
}

/// An audit event for a Darkness Points adjustment on a GameSession.
///
/// Design notes:
/// - Inserted in the same transaction as the dpCount update (UpdateDpCommand).
/// - `rollId` is a nullable loose FK — set when source = ROLL_PUSH.
/// - `@@index([gameSessionId, createdAt])` supports the paginated list query.
model DpEvent {
  id            String      @id @default(cuid())
  gameSessionId String
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  delta         Int
  reason        String?
  source        DpSource
  rollId        String?
  createdAt     DateTime    @default(now())

  @@index([gameSessionId, createdAt])
  @@map("dp_event")
}

/// Join table linking characters to game sessions.
///
/// The composite primary key prevents duplicate assignments.
/// Cascade-deletes ensure the join row is removed when either side is deleted.
model CharacterGameSession {
  characterId   String
  gameSessionId String
  character     Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  assignedAt    DateTime    @default(now())

  @@id([characterId, gameSessionId])
  @@index([gameSessionId])
  @@map("character_game_session")
}

/// A critical injury recorded on a character's sheet.
model CriticalInjury {
  id          String         @id @default(cuid())
  characterId String
  character   Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name        String
  severity    InjurySeverity
  effect      String
  acquiredAt  DateTime       @default(now())

  @@index([characterId])
  @@map("critical_injury")
}

/// A Coriolis dice roll result, persisted for roll history and the push mechanic.
///
/// Design notes:
/// - `dice` is a Postgres integer array — all pool dice are stored together; after
///   a push the non-6 values are updated in place so the array always has `pool`
///   elements.
/// - `hits` is a derived value but is stored to avoid recounting on every read.
///   It is recomputed and overwritten on push.
/// - `gameSessionId` is a nullable String (no FK constraint yet) — the GameSession
///   resource lands in Feature 7.2. The FK will be added in the Feature 7.2
///   migration once the GameSession table exists.
/// - Cascade delete ensures rolls disappear when their character is hard-deleted.
model Roll {
  id            String    @id @default(cuid())
  characterId   String
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// Nullable until Feature 7.2 ships the GameSession resource.
  gameSessionId String?
  label         String
  pool          Int
  dice          Int[]
  hits          Int
  pushed        Boolean   @default(false)
  /// Roll discriminator per ST3001 ГЛАВА 3 §«Вознесение молитв» —
  /// only `skill` rolls can be pushed. Stored as a string for
  /// flexibility; the canonical 5-value enum (skill, save, trauma,
  /// initiative, darkness) is enforced by the spec validator at the
  /// HTTP boundary and a defence-in-depth `RollKind` type guard in
  /// the handler.
  kind          String    @default("skill")
  createdAt     DateTime  @default(now())

  @@index([characterId, createdAt])
  @@index([gameSessionId])
  @@map("roll")
}

// ----- Ships (Phase 5) -----

/// Ship hull class per ST3001 ГЛАВА 7 Table 7.4. The class drives the
/// base stat block (energy, hull, maneuverability, signature, armor,
/// speed, module-slot budget) the create handler seeds from the
/// rules-engine class table. Wire values are kebab-case; Prisma
/// `@map`s them so the database column matches the OpenAPI enum.
enum ShipClass {
  fighter
  shuttle
  torpedo_boat    @map("torpedo-boat")
  light_freighter @map("light-freighter")
  light_passenger @map("light-passenger")
  courier_yacht   @map("courier-yacht")
  clipper
  patrol_boat     @map("patrol-boat")
  gunboat
  assault_ship    @map("assault-ship")
  blockade_runner @map("blockade-runner")
  pleasure_yacht  @map("pleasure-yacht")
  flying_circus   @map("flying-circus")
  prospector
  rescue_ship     @map("rescue-ship")
  passenger_liner @map("passenger-liner")
  heavy_freighter @map("heavy-freighter")
  cruiser
  destroyer
  heavy_cruiser   @map("heavy-cruiser")

  @@map("ship_class")
}

/// Ship-module slot per ST3001 ГЛАВА 7 — distinct from the
/// character-inventory `ItemSlotType`. BRIDGE / REACTOR / DRIVE are
/// mandatory on every ship; the create handler seeds them and the
/// delete handler refuses to drop them (`SHIP_MODULE_MANDATORY` 422).
enum ShipModuleSlot {
  BRIDGE
  REACTOR
  DRIVE
  HOLD
  WEAPON
  TORPEDO
  SENSOR
  COMMS
  HANGAR
  QUARTERS
  MEDICAL
  WORKSHOP
  CHAPEL
  ESCAPE_PODS    @map("ESCAPE-PODS")
  CRYO
  DOCKING
  MINING
  REPAIR
  CONCEALED_HOLD @map("CONCEALED-HOLD")
  PROXY_DECK     @map("PROXY-DECK")
  OTHER

  @@map("ship_module_slot")
}

/// Crew positions per ST3001 ГЛАВА 7. Six slots per ship, composite
/// PK on `(shipId, position)` so the same ship can have at most one
/// holder per role; the same character can hold one position per
/// ship but may serve on multiple ships.
enum CrewPosition {
  captain
  pilot
  sensorOp
  gunner
  engineer
  serviceCrew

  @@map("crew_position")
}

/// A ship as the v1 API sees it. Maps to the OpenAPI `Ship` schema.
///
/// Design notes:
/// - `hull.current/max` and `energy.current/max` are flat columns
///   (not Json) — they're frequently mutated independently and the
///   denormalised shape matches the `Hp`/`Mp` columns on Character.
/// - `problems` is a Postgres text array. Free-text entries from the
///   ГЛАВА 7 wear-and-tear table; not enumerated.
/// - `cargoCapacity` is stored explicitly rather than derived from
///   the HOLD modules. The create handler seeds it from the class
///   table; module mutations don't auto-update it (the spec says
///   "Total cargo capacity in tonnes across all hold modules" but
///   leaves the recalculation to the client). Tracked as a follow-up.
/// - Cascade delete: dropping a Ship drops its modules and crew slots.
model Ship {
  id              String         @id @default(cuid())
  ownerId         String
  owner           User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  class           ShipClass
  model           String?
  registry        String?
  hullCurrent     Int            @default(0)
  hullMax         Int            @default(0)
  energyCurrent   Int            @default(0)
  energyMax       Int            @default(0)
  armor           Int            @default(0)
  maneuverability Int            @default(0)
  signature       Int            @default(0)
  speed           Int            @default(0)
  cargoCapacity   Int            @default(0)
  problems        String[]
  history         String?
  notes           String?
  modules         ShipModule[]
  crew            CrewSlot[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([ownerId])
  @@map("ship")
}

/// An installed ship module. Discriminated union on the API side
/// (`HoldModule`, `WeaponModule`, `TorpedoModule`, `SensorModule`,
/// `OtherModule`) — server stores the type-specific payload as a Json
/// column keyed off `slot`, mirroring the Item table. Validation of
/// the inner shape happens in the command handler against the spec's
/// `ShipModuleCreate` oneOf variants.
model ShipModule {
  id        String         @id @default(cuid())
  shipId    String
  ship      Ship           @relation(fields: [shipId], references: [id], onDelete: Cascade)
  slot      ShipModuleSlot
  name      String
  energyUse Int            @default(0)
  /// Type-specific payload. Structure depends on `slot`:
  ///   HOLD:    { capacityTons, concealed }
  ///   WEAPON:  { damage, range, bonus, crit }
  ///   TORPEDO: { count, damage }
  ///   SENSOR:  { bonus, range }
  ///   OTHER:   { effect }
  ///   BRIDGE/REACTOR/DRIVE/etc: typically empty or a small effect blurb
  data      Json           @default("{}")
  createdAt DateTime       @default(now())

  @@index([shipId])
  @@map("ship_module")
}

/// Crew assignment row. Six slots per ship, optional character
/// reference. ON DELETE SET NULL on the character so the slot stays
/// (the position remains visible as vacant) — mirrors the spec note
/// "Positions without an assigned character are vacant".
model CrewSlot {
  shipId              String
  ship                Ship         @relation(fields: [shipId], references: [id], onDelete: Cascade)
  position            CrewPosition
  assignedCharacterId String?
  assignedCharacter   Character?   @relation(fields: [assignedCharacterId], references: [id], onDelete: SetNull)
  assignedAt          DateTime?

  @@id([shipId, position])
  @@index([assignedCharacterId])
  @@map("crew_slot")
}

// ----- NPCs (Phase 6) -----

/// A non-player character owned by a GM. NPCs are private GM resources —
/// owner-scoped on all read and write paths. They carry no lifecycle state
/// (unlike encounters) and can be added to any encounter at any time.
///
/// Design notes:
/// - `attributes` and `skills` are stored as JSON columns matching the
///   Character model — closed schema, always read/written as a unit.
/// - `armor` and `weapons` are JSON arrays. Put-semantics on PATCH:
///   the entire array is replaced when provided. This mirrors the
///   Character item pattern but avoids a separate ItemArmor/ItemWeapon
///   table since NPCs only carry a handful of items.
/// - `hp` and `mp` current/max are flat columns — both are GM-editable
///   for NPCs (unlike Characters where max is derived from attributes).
/// - Cascade delete: dropping an NPC hard-deletes the row; any encounter
///   combatant rows that snapshot this NPC retain their snapshot copy.
model Npc {
  id               String   @id @default(cuid())
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  /// JSON: { strength, agility, wits, empathy } — each 1–5 (default 2)
  attributes       Json
  /// JSON: { dexterity, force, infiltration, manipulation, meleeCombat,
  ///   observation, rangedCombat, survival, command, culture, dataDjinn,
  ///   medicurgy, mysticPowers, pilot, science, technology } — each 0–5
  skills           Json
  hpCurrent        Int      @default(4)
  hpMax            Int      @default(4)
  mpCurrent        Int      @default(4)
  mpMax            Int      @default(4)
  /// Sensor signature score for ship-combat sensor checks (ST3001 ГЛАВА 14).
  signature        Int      @default(0)
  /// Signed integer bonus applied by the combat tracker to attack/defence rolls.
  keySkillModifier Int      @default(0)
  /// JSON array of ItemArmor objects (put-semantics on PATCH).
  armor            Json     @default("[]")
  /// JSON array of ItemWeapon objects (put-semantics on PATCH).
  weapons          Json     @default("[]")
  /// Free-form GM categorisation labels for filtering and encounter grouping.
  tags             String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId])
  @@map("npc")
}

// ----- Encounters (Phase 6) -----

/// Combat-encounter lifecycle state.
/// Wire values are lowercase ('setup' | 'active' | 'ended').
/// Stored as uppercase in Postgres; the infra mapper converts on read/write.
enum EncounterStatus {
  SETUP
  ACTIVE
  ENDED

  @@map("encounter_status")
}

/// Discriminator for Combatant.combatantType.
/// Wire values are lowercase ('pc' | 'npc'); stored uppercase.
enum CombatantType {
  PC
  NPC

  @@map("combatant_type")
}

/// A combat encounter owned by a game session.
///
/// Design notes:
/// - status transitions are enforced by the domain state machine, not by DB constraints.
/// - activeCombatantId references the Combatant table with onDelete: SetNull so that
///   removing the active combatant falls back gracefully (activeCombatantId → null).
/// - Cascade delete: dropping the GameSession cascades to all its encounters.
model Encounter {
  id                String          @id @default(cuid())
  gameSessionId     String
  gameSession       GameSession     @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  name              String
  notes             String?
  status            EncounterStatus @default(SETUP)
  round             Int             @default(0)
  activeCombatantId String?
  activeCombatant   Combatant?      @relation("ActiveCombatant", fields: [activeCombatantId], references: [id], onDelete: SetNull)
  combatants        Combatant[]     @relation("EncounterCombatants")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([gameSessionId])
  @@map("encounter")
}

/// A single participant (PC or NPC) in a combat encounter.
///
/// Design notes:
/// - combatantType discriminates between PC and NPC participants.
/// - characterId / npcId are nullable; exactly one is non-null depending on combatantType.
/// - pcSnapshot / npcSnapshot store a JSON copy of the relevant stats at add-time.
///   Reads never join the source Character/Npc rows — the snapshot is authoritative.
/// - initiative and turnOrder are null until Block 4 rollInitiative runs.
/// - @@unique constraints enforce COMBATANT_DUPLICATE at the DB level.
/// - Cascade delete: removing the encounter removes all combatants.
model Combatant {
  id              String          @id @default(cuid())
  encounterId     String
  encounter       Encounter       @relation("EncounterCombatants", fields: [encounterId], references: [id], onDelete: Cascade)
  combatantType   CombatantType
  characterId     String?
  npcId           String?
  displayName     String
  initiative      Int?
  turnOrder       Int?
  hpCurrent       Int
  hpMax           Int
  armor           Int             @default(0)
  signature       Int             @default(0)
  statusFlags     String[]        @default([])
  notes           String?
  /// JSON snapshot of source PC stats at add-time (attributes, skills, hpMax, etc.)
  pcSnapshot      Json?
  /// JSON snapshot of source NPC stats at add-time (attributes, skills, hpMax, etc.)
  npcSnapshot     Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  /// Inverse relation for Encounter.activeCombatant
  activeInEncounters Encounter[] @relation("ActiveCombatant")

  @@unique([encounterId, characterId])
  @@unique([encounterId, npcId])
  @@index([encounterId])
  @@map("combatant")
}
