# Strict engine check — pnpm refuses to install if the active Node version
# doesn't satisfy the `engines.node` field in package.json. Without this,
# pnpm silently skips bin-linking when engines mismatch — leaving
# node_modules/.bin/ empty and every `pnpm <script>` invocation failing
# with "command not found".
#
# Run `nvm use` (the repo pins Node 24 via .nvmrc) before `pnpm install`.
engine-strict=true
