{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "motion": {
    "duration": {
      "fast":     { "$value": "100ms", "$type": "duration", "$description": "Hover, press, dot toggles." },
      "default":  { "$value": "200ms", "$type": "duration", "$description": "Standard UI transitions." },
      "slow":     { "$value": "400ms", "$type": "duration", "$description": "Panel enter/exit, drawer slides." },
      "ceremony": { "$value": "600ms", "$type": "duration", "$description": "Dice settle, Icon glow pulse, ritual moments." }
    },
    "ease": {
      "standard": {
        "$value": { "x1": 0.2, "y1": 0.0, "x2": 0.2, "y2": 1.0 },
        "$type": "cubicBezier",
        "$description": "Default easing for most transitions."
      },
      "emphasis": {
        "$value": { "x1": 0.3, "y1": 0.0, "x2": 0.0, "y2": 1.0 },
        "$type": "cubicBezier",
        "$description": "Decisive easing — confirm, commit, apply."
      },
      "linear": {
        "$value": { "x1": 0.0, "y1": 0.0, "x2": 1.0, "y2": 1.0 },
        "$type": "cubicBezier",
        "$description": "Linear — progress bars, mechanical timers."
      }
    },
    "transition": {
      "default": {
        "$type": "transition",
        "$description": "Most-used transition pairing.",
        "$value": {
          "duration": "{motion.duration.default}",
          "delay": "0ms",
          "timingFunction": "{motion.ease.standard}"
        }
      },
      "ceremony": {
        "$type": "transition",
        "$description": "Slower, weightier reveals.",
        "$value": {
          "duration": "{motion.duration.ceremony}",
          "delay": "0ms",
          "timingFunction": "{motion.ease.emphasis}"
        }
      }
    }
  }
}
