{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "shadow": {
    "card-featured": {
      "$type": "shadow",
      "$description": "Inset brass shadow — featured / selected card.",
      "$value": {
        "color": "#6B4E1A",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "1px",
        "inset": true
      }
    },
    "panel-rise": {
      "$type": "shadow",
      "$description": "Subtle indigo lift for elevated panels and modals.",
      "$value": {
        "color": "rgba(11,14,44,0.6)",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px",
        "inset": false
      }
    },
    "icon-glow": {
      "$type": "shadow",
      "$description": "Mystic teal halo for chosen Icons and active mystic elements.",
      "$value": {
        "color": "rgba(43,163,160,0.35)",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "24px",
        "spread": "0px",
        "inset": false
      }
    },
    "brass-bevel": {
      "$type": "shadow",
      "$description": "Pressed bevel for brass buttons and medallions.",
      "$value": [
        {
          "color": "rgba(244,228,184,0.4)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        },
        {
          "color": "rgba(107,78,26,0.6)",
          "offsetX": "0px",
          "offsetY": "-1px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        }
      ]
    },
    "danger-pulse": {
      "$type": "shadow",
      "$description": "Crimson glow for crit-fail and destructive states.",
      "$value": {
        "color": "rgba(229,78,107,0.45)",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "16px",
        "spread": "0px",
        "inset": false
      }
    }
  }
}
