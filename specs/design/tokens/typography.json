{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "font": {
    "family": {
      "display": {
        "$value": ["Forum", "Cormorant Garamond", "serif"],
        "$type": "fontFamily",
        "$description": "Roman-inscriptional, Trajan-inspired (Forum, single weight). Headings, character names, app wordmark."
      },
      "body": {
        "$value": ["Inter", "system-ui", "sans-serif"],
        "$type": "fontFamily",
        "$description": "UI body and labels."
      },
      "mono": {
        "$value": ["JetBrains Mono", "ui-monospace", "monospace"],
        "$type": "fontFamily",
        "$description": "Numerics — HP / MP / dice / encumbrance."
      }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" }
    }
  },
  "type": {
    "$description": "Composite type roles per DESIGN §3.2. Each role decomposes to --type-<role>-{font-family,font-size,line-height,font-weight,letter-spacing} CSS custom properties.",
    "display-xl": {
      "$type": "typography",
      "$description": "Landing headline only.",
      "$value": {
        "fontFamily": "display",
        "fontSize": "48px",
        "lineHeight": "56px",
        "fontWeight": "regular",
        "letterSpacing": "0.06em"
      }
    },
    "display-lg": {
      "$type": "typography",
      "$description": "Character name on sheet header.",
      "$value": {
        "fontFamily": "display",
        "fontSize": "36px",
        "lineHeight": "44px",
        "fontWeight": "regular",
        "letterSpacing": "0.04em"
      }
    },
    "display-md": {
      "$type": "typography",
      "$description": "Section headers (Skills, Inventory).",
      "$value": {
        "fontFamily": "display",
        "fontSize": "28px",
        "lineHeight": "36px",
        "fontWeight": "regular",
        "letterSpacing": "0.04em"
      }
    },
    "display-sm": {
      "$type": "typography",
      "$description": "Stat-block labels.",
      "$value": {
        "fontFamily": "display",
        "fontSize": "20px",
        "lineHeight": "28px",
        "fontWeight": "regular",
        "letterSpacing": "0.08em",
        "textCase": "uppercase"
      }
    },
    "body-lg": {
      "$type": "typography",
      "$description": "Primary body.",
      "$value": {
        "fontFamily": "body",
        "fontSize": "18px",
        "lineHeight": "28px",
        "fontWeight": "regular"
      }
    },
    "body-md": {
      "$type": "typography",
      "$description": "Default body.",
      "$value": {
        "fontFamily": "body",
        "fontSize": "16px",
        "lineHeight": "24px",
        "fontWeight": "regular"
      }
    },
    "body-sm": {
      "$type": "typography",
      "$description": "Labels, captions.",
      "$value": {
        "fontFamily": "body",
        "fontSize": "14px",
        "lineHeight": "20px",
        "fontWeight": "medium"
      }
    },
    "mono-stat-xl": {
      "$type": "typography",
      "$description": "HP and MP big counters.",
      "$value": {
        "fontFamily": "mono",
        "fontSize": "32px",
        "lineHeight": "32px",
        "fontWeight": "bold"
      }
    },
    "mono-stat-md": {
      "$type": "typography",
      "$description": "Skill ranks, item weights.",
      "$value": {
        "fontFamily": "mono",
        "fontSize": "20px",
        "lineHeight": "24px",
        "fontWeight": "medium"
      }
    }
  }
}
