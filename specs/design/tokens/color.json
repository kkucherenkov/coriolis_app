{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "surface": {
      "void":       { "$value": "#0B0E2C", "$type": "color", "$description": "Deepest indigo. App background, dice canvas, voids of space." },
      "night":      { "$value": "#15193F", "$type": "color", "$description": "Card and panel background." },
      "dawn":       { "$value": "#252B5C", "$type": "color", "$description": "Elevated surface — modals, hovered cards." },
      "parchment":  { "$value": "#F2E8D0", "$type": "color", "$description": "Warm light surface for printed-feeling overlays." }
    },
    "brand": {
      "brass-light":  { "$value": "#F4E4B8", "$type": "color", "$description": "Brass highlight. Headings, focused brass on dark." },
      "brass":        { "$value": "#D4A95C", "$type": "color", "$description": "Primary brass. Borders, key UI." },
      "brass-deep":   { "$value": "#A67C28", "$type": "color", "$description": "Aged brass. Hairline rules, secondary borders." },
      "brass-shadow": { "$value": "#6B4E1A", "$type": "color", "$description": "Brass shadow. Inset shadows, deep dividers." }
    },
    "text": {
      "primary":   { "$value": "#F2E8D0", "$type": "color", "$description": "Primary body text on dark surfaces." },
      "secondary": { "$value": "#D9CDB0", "$type": "color", "$description": "Secondary text — captions, helper copy." },
      "ink":       { "$value": "#1A1810", "$type": "color", "$description": "Ink on parchment surfaces." },
      "on-brass":  { "$value": "#0B0E2C", "$type": "color", "$description": "Text rendered on brass fills." }
    },
    "state": {
      "crimson":         { "$value": "#A8324A", "$type": "color", "$description": "Danger fill. Crit failures, destructive actions." },
      "crimson-bright":  { "$value": "#E54E6B", "$type": "color", "$description": "Danger emphasis. Crit text and chip foreground." },
      "mystic-teal":     { "$value": "#2BA3A0", "$type": "color", "$description": "Mystic / Icon-related accent." },
      "success":         { "$value": "#5A8A3A", "$type": "color", "$description": "Success / completion." },
      "darkness":        { "$value": "#5B2A78", "$type": "color", "$description": "The Darkness — corruption, dark points." }
    }
  },
  "theme": {
    "high-contrast": {
      "color": {
        "surface": {
          "void":  { "$value": "#000018", "$type": "color" }
        },
        "brand": {
          "brass": { "$value": "#FFD773", "$type": "color" }
        },
        "text": {
          "primary": { "$value": "#FFFFFF", "$type": "color" }
        }
      }
    }
  }
}
