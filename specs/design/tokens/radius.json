{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "radius": {
    "sm": {
      "$value": "2px",
      "$type": "dimension",
      "$description": "Hairline radius — inputs, dots."
    },
    "md": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Default radius — cards, buttons, inputs."
    },
    "lg": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Large radius — modals, elevated panels."
    },
    "pill": { "$value": "9999px", "$type": "dimension", "$description": "Pill / chip radius." }
  }
}
